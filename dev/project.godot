; Evaluate dev/test harness — consumes the Evaluate library by project reference.
config_version=5

[application]
config/name="Evaluate Dev"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "C#", "Forward Plus")
; iOS export generates every icon slot from the project icon; without one the
; empty-path fallback hard-fails ("Invalid icon (icons/settings_58x58): ''").
config/icon="res://icon_1024.png"

[dotnet]
project/assembly_name="Dev"

[editor_plugins]
enabled=PackedStringArray("res://addons/evaluate_scene/plugin.cfg")

[rendering]
; Mobile exports hard-require ETC2/ASTC texture import — Godot's validator
; fails SILENTLY without it (export_plugin.cpp: should_import_etc2_astc()).
textures/vram_compression/import_etc2_astc=true
