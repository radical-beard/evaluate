<Project Sdk="Microsoft.NET.Sdk">

  <!-- NativeAOT proof harness for the runtime's reflection-adjacent paths:
       publishes a REAL native binary (same compilation model as Godot's iOS
       export) and exercises YamlDotNet frontmatter parsing — via the actual
       production Frontmatter.cs — plus the Lua VM and Tomlyn.
           dotnet publish tools/AotSmoke -c Release && ./tools/AotSmoke/bin/Release/net8.0/*/publish/AotSmoke -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The production parser, compiled into the harness verbatim. -->
    <Compile Include="../../src/Evaluate/Frontmatter.cs" />
    <!-- Same rooting a consuming game gets from Evaluate's embedded descriptor. -->
    <TrimmerRootDescriptor Include="roots.xml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LuaCSharp" Version="0.5.5" />
    <PackageReference Include="Tomlyn" Version="0.19.0" />
    <PackageReference Include="YamlDotNet" Version="16.2.1" />
  </ItemGroup>

</Project>
